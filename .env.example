# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./barbershop.db

# Admin login (required to access the Staff Dashboard, History, Customers, and
# Settings pages). Set a real password; login is disabled while this is blank.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_me_to_a_random_value

# Fallback email notified when a customer checks in, used only if no
# notification emails are configured in Settings
ADMIN_EMAIL=owner@yourbarbershop.com

# Email provider: "resend" or "sendgrid"
EMAIL_PROVIDER=resend

# Resend
RESEND_API_KEY=your_resend_api_key_here

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Sender address used for outgoing notifications
EMAIL_FROM=queue@yourbarbershop.com

# Set to "true" to skip actually sending emails (logs instead)
EMAIL_DRY_RUN=true
