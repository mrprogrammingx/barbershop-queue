# Base URL of the FastAPI backend. Leave unset in dev (Vite proxies /queue/*
# to http://localhost:8002, see vite.config.js). Set this in production to
# the deployed API origin, e.g. https://api.ironandamber.com
VITE_API_BASE_URL=

# Optional: a SnapWidget or Elfsight embed src for a live Instagram feed,
# e.g. https://snapwidget.com/embed/123456. Leave unset to show the themed
# placeholder grid that links out to the Instagram profile instead.
VITE_INSTAGRAM_EMBED_URL=
